{
    "manifest_version": 3,
    "name": "hydeTTV: Twitch chat for Patreon",
    "short_name": "hydeTTV",
    "version": "1.1.1",
    "description": "Puts each creator's Twitch chat on their Patreon livestream pages.",
    "homepage_url": "https://github.com/adamjsturge/hydeTTV",
    "permissions": ["storage", "contentSettings"],
    "host_permissions": ["https://www.patreon.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "hydeTTV",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://www.patreon.com/*"],
            "js": ["shared.js", "content.js"],
            "run_at": "document_idle"
        }
    ]
}
